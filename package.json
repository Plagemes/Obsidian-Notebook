{
  "name": "obsidian-notebook",
  "version": "0.4.1",
  "description": "Handwritten notes with a stylus inside Obsidian (Android + S Pen first).",
  "main": "main.js",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production && node scripts/check-bundle.mjs",
    "lint": "eslint . && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "bench": "vitest run --project perf --silent=false",
    "harness": "node dev/harness/build.mjs --serve",
    "harness:check": "node dev/harness/check.mjs",
    "bench:open": "node dev/harness/open-bench.mjs"
  },
  "keywords": [
    "obsidian",
    "handwriting",
    "stylus",
    "notes"
  ],
  "author": "Plagemes",
  "license": "MIT",
  "dependencies": {
    "perfect-freehand": "1.2.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.15.17",
    "esbuild": "0.28.2",
    "eslint": "^9.39.4",
    "globals": "^17.13.0",
    "obsidian": "1.14.4",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
